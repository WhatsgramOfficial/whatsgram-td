// descriptor. RPC results, active pushes and difference may all pass it to
// EncodeLayer; there is no separate push encoder.
func {{ $accessor.Name }}() LayerType[{{ $accessor.GoType }}] {
    return {{ $accessor.DescriptorName }}
}
