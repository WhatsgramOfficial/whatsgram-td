{{- if $node.Public }}
func {{ $node.PreflightName }}(profile LayerProfile, value {{ $node.GoType }}) (int, error) {
    state := layerCodecState{}
    return {{ $node.PreflightStateName }}(profile, value, &state)
}

func {{ $node.EncodeName }}(profile LayerProfile, value {{ $node.GoType }}, b *bin.Buffer) error {
    state := layerCodecState{}
    return {{ $node.EncodeStateName }}(profile, value, b, &state)
}

func {{ $node.DecodeName }}(profile LayerProfile, b *bin.Buffer) ({{ $node.GoType }}, error) {
    state := layerCodecState{}
    return {{ $node.DecodeStateName }}(profile, b, &state)
}
{{- end }}

func {{ $node.PreflightAnyStateName }}(profile LayerProfile, value any, state *layerCodecState) (int, error) {
    {{- if $node.AcceptPointer }}
    switch typed := value.(type) {
    case {{ $node.GoType }}:
        return {{ $node.PreflightStateName }}(profile, typed, state)
    case *{{ $node.GoType }}:
        if typed == nil { return 0, layerUnavailableTypeRef("preflight", profile, &{{ $node.RefName }}, "nil canonical value") }
        return {{ $node.PreflightStateName }}(profile, *typed, state)
    default:
        return 0, layerUnavailableTypeRef("preflight", profile, &{{ $node.RefName }}, fmt.Sprintf("unexpected canonical value %T", value))
    }
    {{- else }}
    typed, ok := value.({{ $node.GoType }})
    if !ok { return 0, layerUnavailableTypeRef("preflight", profile, &{{ $node.RefName }}, fmt.Sprintf("unexpected canonical value %T", value)) }
    return {{ $node.PreflightStateName }}(profile, typed, state)
    {{- end }}
}

func {{ $node.EncodeAnyStateName }}(profile LayerProfile, value any, b *bin.Buffer, state *layerCodecState) error {
    {{- if $node.AcceptPointer }}
    switch typed := value.(type) {
    case {{ $node.GoType }}:
        return {{ $node.EncodeStateName }}(profile, typed, b, state)
    case *{{ $node.GoType }}:
        if typed == nil { return layerUnavailableTypeRef("encode", profile, &{{ $node.RefName }}, "nil canonical value") }
        return {{ $node.EncodeStateName }}(profile, *typed, b, state)
    default:
        return layerUnavailableTypeRef("encode", profile, &{{ $node.RefName }}, fmt.Sprintf("unexpected canonical value %T", value))
    }
    {{- else }}
    typed, ok := value.({{ $node.GoType }})
    if !ok { return layerUnavailableTypeRef("encode", profile, &{{ $node.RefName }}, fmt.Sprintf("unexpected canonical value %T", value)) }
    return {{ $node.EncodeStateName }}(profile, typed, b, state)
    {{- end }}
}

func {{ $node.DecodeAnyStateName }}(profile LayerProfile, b *bin.Buffer, state *layerCodecState) (any, error) {
    return {{ $node.DecodeStateName }}(profile, b, state)
}

