{{- range $accessor := .LayerTypeRefs.Accessors }}
{{- if $accessor.IsConstructor }}
var {{ $accessor.RefName }} = LayerTypeRef{
    kind: LayerTypeSemantic,
    qname: {{ printf "%q" $accessor.QName }},
    semantic: {{ $accessor.SemanticConstant }},
}

func {{ $accessor.PreflightName }}(profile LayerProfile, value {{ $accessor.GoType }}) (int, error) {
    if value == nil { return 0, layerUnavailableTypeRef("preflight", profile, &{{ $accessor.RefName }}, "nil canonical constructor") }
    state := layerCodecState{}
    return {{ $accessor.NodePreflightStateName }}(profile, *value, &state)
}

func {{ $accessor.EncodeName }}(profile LayerProfile, value {{ $accessor.GoType }}, b *bin.Buffer) error {
    if value == nil { return layerUnavailableTypeRef("encode", profile, &{{ $accessor.RefName }}, "nil canonical constructor") }
    wireID, ok := LayerWireID(profile, {{ $accessor.SemanticConstant }})
    if !ok { return layerUnavailableTypeRef("encode", profile, &{{ $accessor.RefName }}, "constructor is unavailable in exact profile") }
    state := layerCodecState{}
    b.PutID(wireID)
    return {{ $accessor.NodeEncodeStateName }}(profile, *value, b, &state)
}

func {{ $accessor.DecodeStateName }}(profile LayerProfile, b *bin.Buffer, state *layerCodecState) ({{ $accessor.GoType }}, error) {
    wireID, ok := LayerWireID(profile, {{ $accessor.SemanticConstant }})
    if !ok { return nil, layerUnavailableTypeRef("decode", profile, &{{ $accessor.RefName }}, "constructor is unavailable in exact profile") }
    if err := b.ConsumeID(wireID); err != nil { return nil, err }
    if state == nil { return nil, layerUnavailableTypeRef("decode", profile, &{{ $accessor.RefName }}, "nil codec state") }
    value, err := {{ $accessor.NodeDecodeStateName }}(profile, b, state)
    if err != nil { return nil, err }
    return &value, nil
}

func {{ $accessor.DecodeName }}(profile LayerProfile, b *bin.Buffer) ({{ $accessor.GoType }}, error) {
    state := layerCodecState{}
    return {{ $accessor.DecodeStateName }}(profile, b, &state)
}

var {{ $accessor.DescriptorName }} = LayerType[{{ $accessor.GoType }}]{
    ref: &{{ $accessor.RefName }},
    preflight: {{ $accessor.PreflightName }},
    encode: {{ $accessor.EncodeName }},
    decode: {{ $accessor.DecodeName }},
    decodeState: {{ $accessor.DecodeStateName }},
}
{{- end }}

