    }
    if exact.Len() != lease.approvedWireSize || sha256.Sum256(exact.Raw()) != lease.approvedWireDigest {
        return layerDecodedRPCRequest{}, &LayerCodecError{Operation: "adapt unknown innermost RPC method", Profile: profile, Semantic: adapted.semantic, WireID: adapted.wireID, Reason: "adapter returned a call different from the field-admitted canonical request"}
    }

    // The canonical bridge already ran this dispatcher's field callbacks before
    // materializing the canonical request. Revalidation deliberately shares the
    // outer decode state and general preflight, but suppresses a second field
    // observation and disables this extension point to prevent recursion.
