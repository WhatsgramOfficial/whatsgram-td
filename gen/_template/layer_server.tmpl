    }
    if private.Len() != 0 {
        return layerDecodedRPCRequest{}, &LayerCodecError{Operation: "adapt unknown innermost RPC method", Profile: profile, WireID: wireID, Reason: fmt.Sprintf("adapter left %d private terminal bytes", private.Len())}
    }
    if atomic.LoadUint32(&lease.approved) != 1 {
        return layerDecodedRPCRequest{}, &LayerCodecError{Operation: "adapt unknown innermost RPC method", Profile: profile, WireID: wireID, Reason: "adapter did not use the authoritative canonical admission bridge"}
