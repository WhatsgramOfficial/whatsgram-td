    state.rpcAdmission = admittedFields
    atomic.StoreUint32(&p.suppressFieldAdmission, 0)
    atomic.StoreUint32(&p.unknownAdapterDisabled, 0)
    if decodeErr != nil { return layerDecodedRPCRequest{}, decodeErr }
    if exact.Len() != 0 {
        return layerDecodedRPCRequest{}, &LayerCodecError{Operation: "revalidate adapted unknown RPC method", Profile: profile, Semantic: adapted.semantic, WireID: adapted.wireID, Reason: fmt.Sprintf("%d trailing exact bytes", exact.Len())}
    }
    if decoded.call.Profile() != profile || decoded.call.Method() != adapted.semantic || decoded.call.WireID() != adapted.wireID {
