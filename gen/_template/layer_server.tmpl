// OnLayerRPCUnknownMethod registers the single private-schema extension point.
// Generated official routes always take precedence; the callback is reachable
// only after all known transparent wrappers have been recursively peeled.
func (s *ServerDispatcher) OnLayerRPCUnknownMethod(callback LayerRPCUnknownMethodAdapter) {
    if s == nil { panic("tg: register unknown layer RPC method adapter on nil ServerDispatcher") }
    if callback == nil { panic("tg: register nil unknown layer RPC method adapter") }
    if s.unknownMethodAdapter != nil { panic("tg: duplicate unknown layer RPC method adapter") }
    s.unknownMethodAdapter = func(view LayerRPCUnknownMethodView) (layerRPCUnknownMethodResult, bool, error) {
        outbound, handled, err := callback(view)
        if err != nil || !handled {
            return layerRPCUnknownMethodResult{}, handled, err
        }
        return layerRPCUnknownMethodResult{
            profile: outbound.Profile(),
            semantic: outbound.Method(),
            wireID: outbound.WireID(),
            encode: outbound.Encode,
        }, true, nil
    }
}
