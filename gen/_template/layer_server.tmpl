// register preserves the existing OnX facade while rejecting accidental
// duplicate ownership of one semantic method. Multiple layer wire IDs do not
// create multiple registrations.
func (s *ServerDispatcher) register(method LayerSemanticID, handler layerRPCHandler, canonicalResult layerRPCCanonicalResultEncoder) {
    if s == nil {
        panic("tg: register layer RPC handler on nil ServerDispatcher")
    }
    if handler == nil {
        panic("tg: register nil layer RPC handler")
    }
    if canonicalResult == nil {
        panic("tg: register nil canonical layer RPC result encoder")
    }
    if _, duplicate := s.handlers[method]; duplicate {
        category, qname, _ := LayerSemanticName(method)
        panic(fmt.Sprintf("tg: duplicate layer RPC handler for %s:%s", category, qname))
    }
    s.handlers[method] = layerRPCRegisteredHandler{invoke: handler, canonicalResult: canonicalResult}
}

// HasLayerRPCHandler reports whether an admitted semantic method has a
// complete registered handler. It is nil-safe and does not mutate dispatcher
// state, so callers can trace known-but-unimplemented RPCs before dispatch.
func (s *ServerDispatcher) HasLayerRPCHandler(semantic LayerSemanticID) bool {
    if s == nil {
        return false
    }
    handler, ok := s.handlers[semantic]
    return ok && handler.invoke != nil && handler.canonicalResult != nil
}

// Handle retains the historical canonical ServerDispatcher API, including
// established concrete/class/Bool/vector result boxes. Result TypeRefs which
// never had a legacy box return a private bin.Encoder backed by the generated
// canonical descriptor. New exact-profile callers should use AdmitLayer and
// DispatchAdmitted (or HandleLayer) and keep the frozen TypeRef.
func (s *ServerDispatcher) Handle(ctx context.Context, b *bin.Buffer) (bin.Encoder, error) {
    encoded, err := s.HandleLayer(LayerProfileCanonical, ctx, b)
    if err != nil { return nil, err }
    result, ok := encoded.(*layerRPCServerResult)
    if !ok { return encoded, nil }
    return result.encodeCanonicalResult()
}

func prepareLayerRPCRequest(profile LayerProfile, b *bin.Buffer, limits LayerDecodeLimits, callback LayerRPCAdmissionPreflight, fieldCallbacks []LayerRPCAdmissionFieldPreflight, unknownAdapter layerRPCUnknownMethodAdapter) (LayerRequest, error) {
    if b == nil {
        return LayerRequest{}, &LayerCodecError{Operation: "prepare RPC request", Profile: profile, Reason: "nil buffer"}
    }
    wireRequest := b.Raw()
    working := *b
    decoded, err := decodeLayerRPCRequest(profile, &working, limits, callback, fieldCallbacks, unknownAdapter)
    if err != nil { return LayerRequest{}, err }
    if working.Len() != 0 {
        return LayerRequest{}, &LayerCodecError{Operation: "prepare RPC request", Profile: decoded.call.Profile(), Semantic: decoded.call.Method(), WireID: decoded.call.WireID(), Reason: fmt.Sprintf("%d trailing request bytes", working.Len())}
    }
    if len(wireRequest) == 0 || decoded.request == nil {
        return LayerRequest{}, &LayerCodecError{Operation: "prepare RPC request", Profile: decoded.call.Profile(), Semantic: decoded.call.Method(), WireID: decoded.call.WireID(), Reason: "empty wire request or nil canonical request"}
    }
    semanticIdentity := decoded.semanticIdentity
    if !semanticIdentity.valid || semanticIdentity.requestType == nil ||
        semanticIdentity.method != decoded.call.Method() || semanticIdentity.requestType.method != decoded.call.Method() ||
        semanticIdentity.requestType.canonicalWireID == 0 {
        return LayerRequest{}, &LayerCodecError{Operation: "prepare RPC request", Profile: decoded.call.Profile(), Semantic: decoded.call.Method(), WireID: decoded.call.WireID(), Reason: "invalid innermost semantic request identity"}
    }
    wrappers := make([]LayerRPCWrapper, len(decoded.wrappers))
    for index := range decoded.wrappers {
        wrappers[len(decoded.wrappers)-1-index] = decoded.wrappers[index]
    }
    prepared := LayerPreparedCall{
        call: decoded.call,
        wireSize: len(wireRequest),
        wireDigest: sha256.Sum256(wireRequest),
        semanticIdentity: semanticIdentity,
    }
    *b = working
    return LayerRequest{lease: &layerRPCRequestLease{request: decoded.request}, prepared: prepared, wrappers: wrappers}, nil
}

func layerValidateRPCRequestLease(admitted LayerRequest, operation string) (*layerRPCRequestLease, error) {
    lease := admitted.lease
    prepared := admitted.Prepared()
    call := admitted.Call()
    if lease == nil || lease.request == nil || prepared.wireSize <= 0 || prepared.call.Identity() != call.Identity() ||
        !prepared.semanticIdentity.valid || prepared.semanticIdentity.requestType == nil ||
        prepared.semanticIdentity.method != call.Method() || prepared.semanticIdentity.requestType.method != call.Method() ||
        call.canonicalResult == nil || call.wireResult == nil || call.canonical.ref == nil || call.result.ref == nil {
        return nil, &LayerCodecError{Operation: operation, Profile: call.Profile(), Semantic: call.Method(), WireID: call.WireID(), Reason: "invalid or zero prepared admission"}
    }
    return lease, nil
}

{{- if .LayerRPCSource.ClientBridge }}
// PrepareOutbound atomically converts an admitted terminal canonical request
// into one opaque exact-profile outbound call. It never exposes the canonical
// request object. A successful conversion consumes the shared admission lease,
// so no value-copy can subsequently dispatch or reprofile the same request.
// Wrappers are rejected because reducing them to a terminal call would discard
// wrapper-specific side effects and ordering semantics.
func (r LayerRequest) PrepareOutbound(profile LayerProfile) (LayerOutboundCall, error) {
    call := r.Call()
    lease, err := layerValidateRPCRequestLease(r, "prepare admitted RPC outbound call")
    if err != nil { return LayerOutboundCall{}, err }
    if len(r.wrappers) != 0 {
        return LayerOutboundCall{}, &LayerCodecError{Operation: "prepare admitted RPC outbound call", Profile: call.Profile(), Semantic: call.Method(), WireID: call.WireID(), Reason: "transparent RPC wrappers cannot be discarded while reprofiling"}
    }
    outbound, err := PrepareLayerOutboundCall(profile, lease.request)
    if err != nil { return LayerOutboundCall{}, err }
    if outbound.Profile() != profile || outbound.Method() != call.Method() || outbound.WireID() == 0 {
        return LayerOutboundCall{}, &LayerCodecError{Operation: "prepare admitted RPC outbound call", Profile: profile, Semantic: call.Method(), WireID: outbound.WireID(), Reason: "outbound semantic identity does not match admitted request"}
    }
    if !atomic.CompareAndSwapUint32(&lease.consumed, 0, 1) {
        return LayerOutboundCall{}, &LayerCodecError{Operation: "prepare admitted RPC outbound call", Profile: profile, Semantic: call.Method(), WireID: outbound.WireID(), Reason: "admission lease was already consumed"}
    }
    return outbound, nil
}
{{- end }}

// AdmitLayer decodes and completely consumes one request using an already
// frozen exact profile. An explicit invokeWithLayer must select that same
// profile; it cannot mutate a live connection's profile.
func (s *ServerDispatcher) AdmitLayer(profile LayerProfile, b *bin.Buffer) (LayerRequest, error) {
    return s.AdmitLayerWithLimits(profile, b, LayerDecodeLimits{})
}

// AdmitLayerWithLimits is AdmitLayer with one request-scoped bounded decode
// budget. Limits are initialized before any wrapper or terminal typed decode.
func (s *ServerDispatcher) AdmitLayerWithLimits(profile LayerProfile, b *bin.Buffer, limits LayerDecodeLimits) (LayerRequest, error) {
    if s == nil {
        return LayerRequest{}, &LayerCodecError{Operation: "admit RPC request", Profile: profile, Reason: "nil ServerDispatcher"}
    }
    if _, ok := ResolveLayerProfile(int(profile)); !ok {
        return LayerRequest{}, &LayerCodecError{Operation: "admit RPC request", Profile: profile, Reason: "unsupported exact profile"}
    }
    var fieldCallbacks []LayerRPCAdmissionFieldPreflight
    if s.admissionFieldPreflightCount != 0 { fieldCallbacks = s.admissionFieldPreflights }
    return prepareLayerRPCRequest(profile, b, limits, s.admissionPreflight, fieldCallbacks, s.unknownMethodAdapter)
}

// AdmitUnprofiled accepts only the generated invariant invokeWithLayer
// prefix, probes its exact layer without consuming the original buffer, then
// performs ordinary exact admission over the full outer request.
func (s *ServerDispatcher) AdmitUnprofiled(b *bin.Buffer) (LayerRequest, error) {
    return s.AdmitUnprofiledWithLimits(b, LayerDecodeLimits{})
}

// AdmitUnprofiledWithLimits probes only invariant invokeWithLayer, then uses
// the selected exact profile and the same request-scoped decode budget for
// complete admission.
func (s *ServerDispatcher) AdmitUnprofiledWithLimits(b *bin.Buffer, limits LayerDecodeLimits) (LayerRequest, error) {
    if s == nil {
        return LayerRequest{}, &LayerCodecError{Operation: "admit unprofiled RPC wrapper", Reason: "nil ServerDispatcher"}
    }
    profile, err := decodeUnprofiledLayerProfile(b)
    if err != nil { return LayerRequest{}, err }
    return s.AdmitLayerWithLimits(profile, b, limits)
}

func layerRPCNeedsWrapperConsumer(admitted LayerRequest) bool {
    for index := range admitted.wrappers {
        if admitted.wrappers[index].semantic != {{ .LayerRPCSource.Unprofiled.Method }} { return true }
    }
    return false
}

// DispatchAdmitted atomically consumes one immutable admission lease. Value
// copies share that lease, so the same request can never execute twice. A
// successful dispatch retains the handler's raw typed value; boxing and exact
// profile conversion happen only when the returned LayerRPCResult is encoded.
func (s *ServerDispatcher) DispatchAdmitted(ctx context.Context, admitted LayerRequest) (LayerRPCResult, error) {
    if s == nil {
        return nil, &LayerCodecError{Operation: "dispatch admitted RPC", Reason: "nil ServerDispatcher"}
    }
    prepared := admitted.Prepared()
    call := admitted.Call()
    lease, err := layerValidateRPCRequestLease(admitted, "dispatch admitted RPC")
    if err != nil { return nil, err }
    handler, ok := s.handlers[call.Method()]
    if !ok || handler.invoke == nil || handler.canonicalResult == nil {
        return nil, &LayerCodecError{Operation: "dispatch admitted RPC", Profile: call.Profile(), Semantic: call.Method(), WireID: call.WireID(), Reason: "RPC handler is not registered"}
    }
    needsConsumer := layerRPCNeedsWrapperConsumer(admitted)
    if needsConsumer && s.wrapperConsumer == nil {
        return nil, &LayerCodecError{Operation: "dispatch admitted RPC wrappers", Profile: call.Profile(), Semantic: call.Method(), WireID: call.WireID(), Reason: "non-layer RPC wrappers require a registered consumer"}
    }
    if !atomic.CompareAndSwapUint32(&lease.consumed, 0, 1) {
        return nil, &LayerCodecError{Operation: "dispatch admitted RPC", Profile: call.Profile(), Semantic: call.Method(), WireID: call.WireID(), Reason: "admission lease was already consumed"}
    }

    var result LayerRPCResult
    invoke := func(handlerCtx context.Context) error {
        if handlerCtx == nil {
            return &LayerCodecError{Operation: "dispatch admitted RPC", Profile: call.Profile(), Semantic: call.Method(), WireID: call.WireID(), Reason: "nil handler context"}
        }
        value, err := handler.invoke(handlerCtx, lease.request)
        if err != nil { return err }
        result = &layerRPCServerResult{prepared: prepared, value: value, canonicalResult: handler.canonicalResult}
        return nil
    }
    if !needsConsumer {
        if err := invoke(ctx); err != nil { return nil, err }
        return result, nil
    }

    var attempts uint32
    var consumerReturned uint32
    var invokeErr error
    done := make(chan struct{})
    next := func(nextCtx context.Context) error {
        attempt := atomic.AddUint32(&attempts, 1)
        if attempt != 1 {
            return &LayerCodecError{Operation: "dispatch admitted RPC wrappers", Profile: call.Profile(), Semantic: call.Method(), WireID: call.WireID(), Reason: "wrapper consumer called next more than once"}
        }
        defer close(done)
        if atomic.LoadUint32(&consumerReturned) != 0 {
            invokeErr = &LayerCodecError{Operation: "dispatch admitted RPC wrappers", Profile: call.Profile(), Semantic: call.Method(), WireID: call.WireID(), Reason: "wrapper consumer let next escape its synchronous call"}
            return invokeErr
        }
        invokeErr = invoke(nextCtx)
        if atomic.LoadUint32(&consumerReturned) != 0 {
            invokeErr = &LayerCodecError{Operation: "dispatch admitted RPC wrappers", Profile: call.Profile(), Semantic: call.Method(), WireID: call.WireID(), Reason: "wrapper consumer returned before next completed", Cause: invokeErr}
        }
        return invokeErr
    }
    consumerErr := s.wrapperConsumer(ctx, admitted, next)
    atomic.StoreUint32(&consumerReturned, 1)
    attemptCount := atomic.LoadUint32(&attempts)
    if attemptCount != 1 {
        if attemptCount != 0 { <-done }
        return nil, &LayerCodecError{Operation: "dispatch admitted RPC wrappers", Profile: call.Profile(), Semantic: call.Method(), WireID: call.WireID(), Reason: fmt.Sprintf("wrapper consumer called next %d times, want exactly once", attemptCount), Cause: consumerErr}
    }
    <-done
    if invokeErr != nil { return nil, invokeErr }
    if consumerErr != nil { return nil, consumerErr }
    if result == nil {
        return nil, &LayerCodecError{Operation: "dispatch admitted RPC wrappers", Profile: call.Profile(), Semantic: call.Method(), WireID: call.WireID(), Reason: "wrapper consumer completed without a handler result"}
    }
    return result, nil
}

// HandleLayer is the compatibility convenience path for a connection whose
// exact profile is already frozen. A known generated route returns a
// LayerRPCResult carrying that admission's exact result TypeRef; it never
// converts the value to Handle's legacy canonical box. Unknown top-level IDs
// may use fallback, while known IDs never bypass generated admission.
func (s *ServerDispatcher) HandleLayer(profile LayerProfile, ctx context.Context, b *bin.Buffer) (bin.Encoder, error) {
    if _, ok := ResolveLayerProfile(int(profile)); !ok {
        return nil, &LayerCodecError{Operation: "decode request", Profile: profile, Reason: "unsupported exact profile"}
    }
    if b == nil { return nil, &LayerCodecError{Operation: "decode request", Profile: profile, Reason: "nil buffer"} }
    id, err := b.PeekID()
    if err != nil {
        return nil, err
    }
    if _, ok := LayerSemanticForWireID(profile, id); !ok {
        if s.fallback == nil {
            return nil, &LayerCodecError{Operation: "decode request", Profile: profile, WireID: id, Reason: "unknown RPC method", Cause: ErrLayerUnknownRPCMethod}
        }
        return s.fallback(ctx, b)
    }
    admitted, err := s.AdmitLayer(profile, b)
    if err != nil { return nil, err }
    result, err := s.DispatchAdmitted(ctx, admitted)
    if err != nil { return nil, err }
    return result, nil
}

// HandleUnprofiled is the compatibility convenience for a first request.
// Only invariant invokeWithLayer is admitted; unknown IDs may use fallback.
func (s *ServerDispatcher) HandleUnprofiled(ctx context.Context, b *bin.Buffer) (bin.Encoder, error) {
    if b == nil { return nil, &LayerCodecError{Operation: "decode unprofiled request", Reason: "nil buffer"} }
    id, err := b.PeekID()
    if err != nil { return nil, err }
    if id != 0x{{ printf "%08x" .LayerRPCSource.Unprofiled.WireID }} {
        if s != nil && s.fallback != nil { return s.fallback(ctx, b) }
        return nil, &LayerCodecError{Operation: "decode unprofiled request", WireID: id, Reason: "only invariant invokeWithLayer is accepted before profile freeze"}
    }
    admitted, err := s.AdmitUnprofiled(b)
    if err != nil { return nil, err }
    result, err := s.DispatchAdmitted(ctx, admitted)
    if err != nil { return nil, err }
    return result, nil
}

