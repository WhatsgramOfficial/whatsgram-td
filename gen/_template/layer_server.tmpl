{{- if .LayerRPCSource.ClientBridge }}
    adaptCanonical func(*bin.Buffer) (LayerOutboundCall, error)
    adaptClientRPCOverlay func(LayerClientRPCOverlay) (*bin.Buffer, bool, error)
{{- end }}
}

// LayerRPCUnknownMethodView is a synchronous, transactional view of an
// unknown innermost terminal method. Buffer returns a defensive private copy;
// adapter failures and unhandled results can never consume or mutate the
// caller's request. The view and returned cursor must not escape the callback
// or be accessed from another goroutine.
type LayerRPCUnknownMethodView struct {
    profile LayerProfile
    wireID uint32
    wireSize int
    lease *layerRPCUnknownMethodViewLease
}

func (v LayerRPCUnknownMethodView) Profile() LayerProfile { return v.profile }
func (v LayerRPCUnknownMethodView) WireID() uint32 { return v.wireID }
func (v LayerRPCUnknownMethodView) WireSize() int { return v.wireSize }

func (v LayerRPCUnknownMethodView) activeLease(operation string) (*layerRPCUnknownMethodViewLease, error) {
    if v.lease == nil || atomic.LoadUint32(&v.lease.active) != 1 {
        return nil, &LayerCodecError{Operation: operation, Profile: v.profile, WireID: v.wireID, Reason: "unknown method adapter view is no longer active"}
    }
    return v.lease, nil
}

// Buffer returns the one private cursor owned by this synchronous callback. A
// handled adapter must completely consume it. The cursor must not escape or be
// accessed concurrently; only the caller's original buffer is isolated by the
// defensive copy.
func (v LayerRPCUnknownMethodView) Buffer() (*bin.Buffer, error) {
    lease, err := v.activeLease("inspect unknown innermost RPC method")
    if err != nil { return nil, err }
    return lease.body, nil
}

{{- if .LayerRPCSource.ClientBridge }}
// AdaptCanonical performs the only authoritative private-to-generated bridge.
// It admits one canonical terminal request using this dispatcher's exact field
// callbacks before materialization, then statically re-profiles it. The core
// later verifies the returned opaque call with the adapter disabled.
func (v LayerRPCUnknownMethodView) AdaptCanonical(canonical *bin.Buffer) (LayerOutboundCall, error) {
    lease, err := v.activeLease("adapt canonical unknown RPC method")
    if err != nil { return LayerOutboundCall{}, err }
    if canonical == nil {
        return LayerOutboundCall{}, &LayerCodecError{Operation: "adapt canonical unknown RPC method", Profile: v.profile, WireID: v.wireID, Reason: "nil canonical buffer"}
    }
    if lease.adaptCanonical == nil {
        return LayerOutboundCall{}, &LayerCodecError{Operation: "adapt canonical unknown RPC method", Profile: v.profile, WireID: v.wireID, Reason: "canonical bridge is unavailable"}
    }
    if !atomic.CompareAndSwapUint32(&lease.approved, 0, 2) {
        return LayerOutboundCall{}, &LayerCodecError{Operation: "adapt canonical unknown RPC method", Profile: v.profile, WireID: v.wireID, Reason: "canonical bridge may be used only once"}
    }
    outbound, err := lease.adaptCanonical(canonical)
    if err != nil { return LayerOutboundCall{}, err }
    if outbound.Profile() != v.profile || outbound.Method() == 0 || outbound.WireID() == 0 {
        return LayerOutboundCall{}, &LayerCodecError{Operation: "adapt canonical unknown RPC method", Profile: v.profile, Semantic: outbound.Method(), WireID: outbound.WireID(), Reason: "canonical bridge returned an invalid exact identity"}
    }
    var exact bin.Buffer
    if err := outbound.Encode(&exact); err != nil { return LayerOutboundCall{}, err }
    if exact.Len() == 0 {
        return LayerOutboundCall{}, &LayerCodecError{Operation: "adapt canonical unknown RPC method", Profile: v.profile, Semantic: outbound.Method(), WireID: outbound.WireID(), Reason: "canonical bridge encoded an empty exact request"}
    }
    lease.approvedSemantic = outbound.Method()
    lease.approvedWireID = outbound.WireID()
    lease.approvedWireSize = exact.Len()
    lease.approvedWireDigest = sha256.Sum256(exact.Raw())
    atomic.StoreUint32(&lease.approved, 1)
    return outbound, nil
}

// AdaptClientRPCOverlay invokes one gotdgen-compiled client-private method
// decoder against this view's exact connection profile, then passes its
// canonical value through the authoritative admission/re-profiling bridge.
// handled=false means the selected overlay does not own this constructor.
func (v LayerRPCUnknownMethodView) AdaptClientRPCOverlay(overlay LayerClientRPCOverlay) (LayerOutboundCall, bool, error) {
    lease, err := v.activeLease("adapt generated client RPC overlay")
    if err != nil { return LayerOutboundCall{}, true, err }
    if lease.adaptClientRPCOverlay == nil {
        return LayerOutboundCall{}, true, &LayerCodecError{Operation: "adapt generated client RPC overlay", Profile: v.profile, WireID: v.wireID, Reason: "generated client overlay bridge is unavailable"}
    }
    canonical, handled, err := lease.adaptClientRPCOverlay(overlay)
    if err != nil || !handled { return LayerOutboundCall{}, handled, err }
    if canonical == nil {
        return LayerOutboundCall{}, true, &LayerCodecError{Operation: "adapt generated client RPC overlay", Profile: v.profile, WireID: v.wireID, Reason: "generated client overlay returned nil canonical request"}
    }
    outbound, err := v.AdaptCanonical(canonical)
    if err != nil { return LayerOutboundCall{}, true, err }
    return outbound, true, nil
}

// LayerRPCUnknownMethodAdapter handles only an exact-profile switch miss at
// the innermost terminal. handled=false preserves ErrLayerUnknownRPCMethod.
// A handled result must come from view.AdaptCanonical.
type LayerRPCUnknownMethodAdapter func(LayerRPCUnknownMethodView) (LayerOutboundCall, bool, error)
{{- end }}

type layerRPCAdmissionViewLease struct {
    active uint32
    body []byte
}

// LayerRPCAdmissionView exposes bounded inspection of one terminal wire
// request without exposing the decoder's backing byte slice. Raw access is
// valid only during the synchronous preflight callback.
type LayerRPCAdmissionView struct {
    profile LayerProfile
    semantic LayerSemanticID
    wireID uint32
    wireSize int
    lease *layerRPCAdmissionViewLease
}

func (v LayerRPCAdmissionView) Profile() LayerProfile { return v.profile }
func (v LayerRPCAdmissionView) Semantic() LayerSemanticID { return v.semantic }
func (v LayerRPCAdmissionView) WireID() uint32 { return v.wireID }
func (v LayerRPCAdmissionView) WireSize() int { return v.wireSize }

func (v LayerRPCAdmissionView) activeBody(operation string) ([]byte, error) {
    if v.lease == nil || atomic.LoadUint32(&v.lease.active) != 1 {
        return nil, &LayerCodecError{Operation: operation, Profile: v.profile, Semantic: v.semantic, WireID: v.wireID, Reason: "admission preflight view is no longer active"}
    }
    return v.lease.body, nil
}

// ByteAt returns one terminal wire byte while the callback is active.
func (v LayerRPCAdmissionView) ByteAt(offset int) (byte, error) {
    body, err := v.activeBody("inspect RPC admission byte")
    if err != nil { return 0, err }
    if offset < 0 || offset >= len(body) {
        return 0, &LayerCodecError{Operation: "inspect RPC admission byte", Profile: v.profile, Semantic: v.semantic, WireID: v.wireID, Reason: fmt.Sprintf("byte offset %d outside terminal wire size %d", offset, len(body))}
    }
    return body[offset], nil
}

// Uint32At returns one little-endian uint32 without advancing admission.
func (v LayerRPCAdmissionView) Uint32At(offset int) (uint32, error) {
    body, err := v.activeBody("inspect RPC admission uint32")
    if err != nil { return 0, err }
    if offset < 0 || offset > len(body) || len(body)-offset < 4 {
        return 0, &LayerCodecError{Operation: "inspect RPC admission uint32", Profile: v.profile, Semantic: v.semantic, WireID: v.wireID, Reason: fmt.Sprintf("uint32 offset %d outside terminal wire size %d", offset, len(body))}
    }
    return uint32(body[offset]) | uint32(body[offset+1])<<8 | uint32(body[offset+2])<<16 | uint32(body[offset+3])<<24, nil
}

// ReadAt returns a defensive copy of one bounded terminal wire range.
func (v LayerRPCAdmissionView) ReadAt(offset, length int) ([]byte, error) {
    body, err := v.activeBody("inspect RPC admission bytes")
    if err != nil { return nil, err }
    if offset < 0 || length < 0 || offset > len(body) || length > len(body)-offset {
        return nil, &LayerCodecError{Operation: "inspect RPC admission bytes", Profile: v.profile, Semantic: v.semantic, WireID: v.wireID, Reason: fmt.Sprintf("byte range [%d,%d) outside terminal wire size %d", offset, offset+length, len(body))}
    }
    copied := make([]byte, length)
    copy(copied, body[offset:offset+length])
    return copied, nil
}

type layerRPCAdmissionPreflightRunner struct {
    callback LayerRPCAdmissionPreflight
    fields *layerRPCAdmissionFieldRunner
    unknownAdapter layerRPCUnknownMethodAdapter
    profileAdmission layerRPCProfileAdmissionMode
    admissionProfile LayerProfile
    explicitProfile LayerProfile
    explicitProfileSet bool
    probedProfile LayerProfile
    probedProfileSet bool
    defaultWrapperReplay bool
{{- if .LayerRPCSource.ClientBridge }}
    adaptCanonical func(LayerProfile, *bin.Buffer) (LayerOutboundCall, error)
{{- end }}
    called uint32
    unknownAdapterActive uint32
    unknownAdapterDisabled uint32
    suppressFieldAdmission uint32
}

func (p *layerRPCAdmissionPreflightRunner) allowDefaultWrapperFallback(current LayerProfile) bool {
    return p != nil && p.profileAdmission == layerRPCProfileDefault && !p.explicitProfileSet &&
        !p.defaultWrapperReplay && current == p.admissionProfile
}

// selectExplicitProfile applies the only runtime profile-selection rule used
// by generated transparent wrappers. In default mode exactly one explicit
// profile may replace the inherited caller default; repeated selectors must
// agree. Frozen mode preserves AdmitLayer's strict conflict behavior.
func (p *layerRPCAdmissionPreflightRunner) selectExplicitProfile(current, selected LayerProfile, semantic LayerSemanticID, wireID uint32) error {
    if p == nil {
        return &LayerCodecError{Operation: "admit RPC wrapper", Profile: current, Semantic: semantic, WireID: wireID, Reason: "nil profile admission state"}
    }
    switch p.profileAdmission {
    case layerRPCProfileFrozen:
        if current != p.admissionProfile {
            return &LayerCodecError{Operation: "admit RPC wrapper", Profile: current, Semantic: semantic, WireID: wireID, Reason: fmt.Sprintf("current profile %d differs from frozen admission profile %d", current, p.admissionProfile)}
        }
        if selected != p.admissionProfile {
            return &LayerCodecError{Operation: "admit RPC wrapper", Profile: current, Semantic: semantic, WireID: wireID, Reason: fmt.Sprintf("invokeWithLayer selected profile %d, want frozen admission profile %d", selected, p.admissionProfile)}
        }
    case layerRPCProfileDefault:
        if p.explicitProfileSet {
            if current != p.explicitProfile {
                return &LayerCodecError{Operation: "admit RPC wrapper", Profile: current, Semantic: semantic, WireID: wireID, Reason: fmt.Sprintf("current profile %d differs from explicit invokeWithLayer profile %d", current, p.explicitProfile)}
            }
            if selected != p.explicitProfile {
                return &LayerCodecError{Operation: "admit RPC wrapper", Profile: current, Semantic: semantic, WireID: wireID, Reason: fmt.Sprintf("invokeWithLayer selected profile %d, conflicts with explicit profile %d", selected, p.explicitProfile)}
            }
        } else if p.probedProfileSet {
            if current != p.probedProfile || selected != p.probedProfile {
                return &LayerCodecError{Operation: "admit RPC wrapper", Profile: current, Semantic: semantic, WireID: wireID, Reason: fmt.Sprintf("invokeWithLayer profile %d under current profile %d differs from probed profile %d", selected, current, p.probedProfile), Cause: ErrLayerProfileAmbiguous}
            }
        } else if current != p.admissionProfile {
            return &LayerCodecError{Operation: "admit RPC wrapper", Profile: current, Semantic: semantic, WireID: wireID, Reason: fmt.Sprintf("current profile %d differs from inherited admission profile %d", current, p.admissionProfile)}
        }
    default:
        return &LayerCodecError{Operation: "admit RPC wrapper", Profile: current, Semantic: semantic, WireID: wireID, Reason: "invalid profile admission mode"}
    }
    p.explicitProfile = selected
    p.explicitProfileSet = true
    return nil
}

func (p *layerRPCAdmissionPreflightRunner) run(profile LayerProfile, semantic LayerSemanticID, wireID uint32, b *bin.Buffer) error {
    if p == nil {
        return &LayerCodecError{Operation: "preflight RPC admission", Profile: profile, Semantic: semantic, WireID: wireID, Reason: "nil preflight runner"}
    }
    if !atomic.CompareAndSwapUint32(&p.called, 0, 1) {
        return &LayerCodecError{Operation: "preflight RPC admission", Profile: profile, Semantic: semantic, WireID: wireID, Reason: "terminal admission preflight ran more than once"}
    }
    if b == nil {
        return &LayerCodecError{Operation: "preflight RPC admission", Profile: profile, Semantic: semantic, WireID: wireID, Reason: "nil terminal wire buffer"}
    }
    if atomic.LoadUint32(&p.suppressFieldAdmission) == 0 {
        if err := p.fields.begin(profile, semantic, wireID); err != nil { return err }
    }
    if p.callback == nil { return nil }
    body := b.Raw()
    lease := &layerRPCAdmissionViewLease{active: 1, body: body}
    view := LayerRPCAdmissionView{profile: profile, semantic: semantic, wireID: wireID, wireSize: len(body), lease: lease}
    defer atomic.StoreUint32(&lease.active, 0)
    return p.callback(view)
}

type layerRPCServerResult struct {
    prepared LayerPreparedCall
    value any
    canonicalResult layerRPCCanonicalResultEncoder
}

func (r *layerRPCServerResult) Prepared() LayerPreparedCall {
    if r == nil { return LayerPreparedCall{} }
    return r.prepared
}

func (r *layerRPCServerResult) WireInvariant() bool {
    return r != nil && r.prepared.Call().WireInvariant()
}

func (r *layerRPCServerResult) Freeze() (LayerFrozenResult, error) {
    if r == nil {
        return LayerFrozenResult{}, errors.New("can't freeze nil layer RPC result")
    }
    return r.prepared.Call().FreezeResult(r.value)
}

func (r *layerRPCServerResult) Prepare() (LayerPreparedResult, error) {
    if r == nil {
        return LayerPreparedResult{}, errors.New("can't prepare nil layer RPC result")
    }
    return r.prepared.Call().prepareResult(r.value)
}

func (r *layerRPCServerResult) encodeCanonicalResult() (bin.Encoder, error) {
    if r == nil {
        return nil, errors.New("can't encode nil canonical layer RPC result")
    }
    if r.canonicalResult == nil {
        return nil, &LayerCodecError{Operation: "encode canonical RPC result", Profile: r.prepared.Call().Profile(), Semantic: r.prepared.Call().Method(), WireID: r.prepared.Call().WireID(), Reason: "canonical result adapter is not registered"}
    }
    return r.canonicalResult(r.value)
}

// Encode uses the immutable call descriptor captured at admission. RPC
// results therefore use the same generated bound codec core as EncodeLayer
// and can never observe a later session-layer change.
func (r *layerRPCServerResult) Encode(b *bin.Buffer) error {
    if r == nil {
        return errors.New("can't encode nil layer RPC result")
    }
    return r.prepared.Call().EncodeResult(r.value, b)
}

var _ LayerRPCResult = (*layerRPCServerResult)(nil)

type ServerDispatcher struct {
    fallback func(ctx context.Context, b *bin.Buffer) (bin.Encoder, error)
    handlers map[LayerSemanticID]layerRPCRegisteredHandler
    wrapperConsumer LayerRPCWrapperConsumer
    admissionPreflight LayerRPCAdmissionPreflight
    admissionFieldPreflights []LayerRPCAdmissionFieldPreflight
    admissionFieldPreflightCount int
    unknownMethodAdapter layerRPCUnknownMethodAdapter
}

func NewServerDispatcher(fallback func(ctx context.Context, b *bin.Buffer) (bin.Encoder, error)) *ServerDispatcher {
    return &ServerDispatcher{
        fallback: fallback,
        handlers: make(map[LayerSemanticID]layerRPCRegisteredHandler),
    }
}

// OnLayerRPCAdmissionFieldPreflight registers one generated canonical field
// metric. Registration fails closed unless every routable profile exposes the
// same metric directly; unavailable methods are the only accepted absence.
// Register callbacks before serving concurrent admissions.
func (s *ServerDispatcher) OnLayerRPCAdmissionFieldPreflight(fieldID LayerRPCFieldID, callback LayerRPCAdmissionFieldPreflight) error {
    if s == nil { return fmt.Errorf("tg: register layer RPC admission field preflight on nil ServerDispatcher") }
    if callback == nil { return fmt.Errorf("tg: register nil layer RPC admission field preflight") }
    index, err := layerRPCAdmissionFieldRegistration(fieldID)
    if err != nil { return err }
    if s.admissionFieldPreflights == nil {
        s.admissionFieldPreflights = make([]LayerRPCAdmissionFieldPreflight, layerRPCAdmissionFieldCount)
    }
    if index < 0 || index >= len(s.admissionFieldPreflights) {
        return fmt.Errorf("tg: generated layer RPC admission field index %d is out of range", index)
    }
    if s.admissionFieldPreflights[index] != nil {
        return fmt.Errorf("tg: duplicate layer RPC admission field preflight for %#016x", uint64(fieldID))
    }
    s.admissionFieldPreflights[index] = callback
    s.admissionFieldPreflightCount++
    return nil
}

// OnLayerRPCWrappers registers the single owner of wrapper semantics such as
// invokeAfterMsg(s), invokeWithoutUpdates, takeout, message ranges, and
// initConnection. invokeWithLayer itself is consumed by exact admission.
func (s *ServerDispatcher) OnLayerRPCWrappers(consumer LayerRPCWrapperConsumer) {
    if s == nil { panic("tg: register layer RPC wrapper consumer on nil ServerDispatcher") }
    if consumer == nil { panic("tg: register nil layer RPC wrapper consumer") }
    if s.wrapperConsumer != nil { panic("tg: duplicate layer RPC wrapper consumer") }
    s.wrapperConsumer = consumer
}

// OnLayerRPCAdmissionPreflight registers the single synchronous admission
// guard. It observes only the innermost known terminal route and runs before
// that route performs any typed decode or allocation.
func (s *ServerDispatcher) OnLayerRPCAdmissionPreflight(callback LayerRPCAdmissionPreflight) {
    if s == nil { panic("tg: register layer RPC admission preflight on nil ServerDispatcher") }
    if callback == nil { panic("tg: register nil layer RPC admission preflight") }
    if s.admissionPreflight != nil { panic("tg: duplicate layer RPC admission preflight") }
    s.admissionPreflight = callback
}

