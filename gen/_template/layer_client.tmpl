{{- else }}
func (c *LayerClient) invoke{{ $method.Name }}(ctx context.Context, request *{{ $method.Structure.Name }}) ({{ $method.ResultType }}, error) {
    var zero {{ $method.ResultType }}
    if c == nil {
        return zero, &LayerCodecError{Operation: "invoke RPC layer client", Semantic: {{ $method.Method.Constant }}, Reason: "nil layer client"}
    }
    call, err := layerPrepareClient{{ $method.Name }}(c.profile, request)
    if err != nil { return zero, err }
    raw, err := c.invoke(ctx, call)
    if err != nil { return zero, err }
    {{- if $method.PointerResult }}
    switch typed := raw.(type) {
    case {{ $method.ResultGoType }}:
        copy := typed
        return &copy, nil
    case *{{ $method.ResultGoType }}:
        if typed == nil { return zero, &LayerCodecError{Operation: "decode RPC client result", Profile: c.profile, Semantic: {{ $method.Method.Constant }}, Reason: "nil canonical result"} }
        return typed, nil
    default:
        return zero, &LayerCodecError{Operation: "decode RPC client result", Profile: c.profile, Semantic: {{ $method.Method.Constant }}, Reason: fmt.Sprintf("canonical result has type %T, want {{ $method.ResultType }}", raw)}
    }
    {{- else if $method.PointerValueResult }}
    switch typed := raw.(type) {
    case {{ $method.ResultGoType }}:
        return typed, nil
    case *{{ $method.ResultGoType }}:
        if typed == nil { return zero, &LayerCodecError{Operation: "decode RPC client result", Profile: c.profile, Semantic: {{ $method.Method.Constant }}, Reason: "nil canonical result"} }
        return *typed, nil
    default:
        return zero, &LayerCodecError{Operation: "decode RPC client result", Profile: c.profile, Semantic: {{ $method.Method.Constant }}, Reason: fmt.Sprintf("canonical result has type %T, want {{ $method.ResultType }}", raw)}
    }
    {{- else if $method.BoolResult }}
    value, ok := raw.(BoolClass)
    if !ok {
        return false, &LayerCodecError{Operation: "decode RPC client result", Profile: c.profile, Semantic: {{ $method.Method.Constant }}, Reason: fmt.Sprintf("canonical Bool result has type %T", raw)}
    }
    switch value.(type) {
    case *BoolTrue:
        return true, nil
    case *BoolFalse:
        return false, nil
    default:
        return false, &LayerCodecError{Operation: "decode RPC client result", Profile: c.profile, Semantic: {{ $method.Method.Constant }}, Reason: fmt.Sprintf("canonical Bool result has constructor %T", value)}
    }
    {{- else }}
    typed, ok := raw.({{ $method.ResultType }})
    if !ok {
        return zero, &LayerCodecError{Operation: "decode RPC client result", Profile: c.profile, Semantic: {{ $method.Method.Constant }}, Reason: fmt.Sprintf("canonical result has type %T, want {{ $method.ResultType }}", raw)}
    }
    return typed, nil
    {{- end }}
}

