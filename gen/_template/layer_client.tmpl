{{- if $method.ErrorOnly }}
func (c *LayerClient) invoke{{ $method.Name }}(ctx context.Context, request *{{ $method.Structure.Name }}) error {
    if c == nil {
        return &LayerCodecError{Operation: "invoke RPC layer client", Semantic: {{ $method.Method.Constant }}, Reason: "nil layer client"}
    }
    call, err := layerPrepareClient{{ $method.Name }}(c.profile, request)
    if err != nil { return err }
    _, err = c.invoke(ctx, call)
