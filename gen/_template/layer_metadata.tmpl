{{ define "layer_metadata" }}
{{ template "header" . }}

// LayerProfile is one exact API schema profile. Values are never clamped or
// guessed; unknown layers must be rejected or handled by an explicit adapter.
type LayerProfile int

const (
{{- range $layer := .LayerMetadata.Profiles }}
    LayerProfile{{ $layer }} LayerProfile = {{ $layer }}
{{- end }}
    LayerProfileCanonical LayerProfile = {{ .LayerMetadata.CanonicalLayer }}
)

// ResolveLayerProfile resolves only exact generated profiles.
func ResolveLayerProfile(layer int) (LayerProfile, bool) {
    switch LayerProfile(layer) {
{{- range $layer := .LayerMetadata.Profiles }}
    case LayerProfile{{ $layer }}:
        return LayerProfile{{ $layer }}, true
{{- end }}
    default:
        return 0, false
    }
}

// LayerSemanticID is the deterministic category-qualified TL semantic identity
// used to select a profile-specific wire constructor or method ID. It is
// stable when new schemas are added, but is generated code metadata and must
// not be persisted as an external protocol value.
type LayerSemanticID uint64

const (
    LayerSemanticInvalid LayerSemanticID = 0
{{- range $family := .LayerMetadata.Families }}
    {{ $family.Constant }} LayerSemanticID = 0x{{ printf "%016x" $family.ID }}
{{- end }}
)

// LayerSemanticName reports the TL category and qualified name.
func LayerSemanticName(id LayerSemanticID) (category, qname string, ok bool) {
    switch id {
{{- range $family := .LayerMetadata.Families }}
    case {{ $family.Constant }}:
        return "{{ $family.Category }}", "{{ $family.QName }}", true
{{- end }}
    default:
        return "", "", false
    }
}

func layerCanonicalWireID(id LayerSemanticID) (uint32, bool) {
    switch id {
{{- range $family := .LayerMetadata.Families }}{{ if $family.Canonical }}
    case {{ $family.Constant }}:
        return 0x{{ printf "%08x" $family.CanonicalWireID }}, true
{{- end }}{{- end }}
    default:
        return 0, false
    }
}

// LayerWireID resolves a semantic constructor or method in an exact profile.
func LayerWireID(profile LayerProfile, semantic LayerSemanticID) (uint32, bool) {
    switch profile {
{{- range $profile := .LayerMetadata.Overrides }}
    case LayerProfile{{ $profile.Layer }}:
        switch semantic {
{{- range $entry := $profile.Entries }}
        case {{ $entry.Constant }}:
{{- if $entry.Present }}
            return 0x{{ printf "%08x" $entry.WireID }}, true
{{- else }}
            return 0, false
{{- end }}
{{- end }}
        }
{{- end }}
    case LayerProfileCanonical:
        // Canonical mappings are handled below.
    default:
        return 0, false
    }
    return layerCanonicalWireID(semantic)
}

func layerSemanticByWireID(id uint32) (LayerSemanticID, bool) {
    switch id {
{{- range $wire := .LayerMetadata.Wires }}
    case 0x{{ printf "%08x" $wire.WireID }}:
        return {{ $wire.Constant }}, true
{{- end }}
    default:
        return LayerSemanticInvalid, false
    }
}

// LayerSemanticForWireID resolves an ID only when it is a member of profile.
func LayerSemanticForWireID(profile LayerProfile, id uint32) (LayerSemanticID, bool) {
    semantic, ok := layerSemanticByWireID(id)
    if !ok {
        return LayerSemanticInvalid, false
    }
    expected, ok := LayerWireID(profile, semantic)
    if !ok || expected != id {
        return LayerSemanticInvalid, false
    }
    return semantic, true
}
{{ end }}
