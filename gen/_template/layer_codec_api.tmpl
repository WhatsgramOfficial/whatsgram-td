// LayerTypeKind classifies a complete generated TL TypeRef.
type LayerTypeKind uint8

const (
    LayerTypeInvalid LayerTypeKind = iota
    LayerTypePrimitive
    LayerTypeSemantic
    LayerTypeVector
    LayerTypeGeneric
    LayerTypeObject
)

// LayerTypeRef is immutable generated metadata for one complete TL type
// reference. Fields are private so callers cannot mutate a frozen RPC result
// context. Element is non-nil only for generic applications such as vectors.
type LayerTypeRef struct {
    kind     LayerTypeKind
    qname    string
    semantic LayerSemanticID
    bare     bool
    percent  bool
    element  *LayerTypeRef
}

func (r *LayerTypeRef) Kind() LayerTypeKind {
    if r == nil { return LayerTypeInvalid }
    return r.kind
}

func (r *LayerTypeRef) QName() string {
    if r == nil { return "" }
    return r.qname
}

func (r *LayerTypeRef) Semantic() LayerSemanticID {
    if r == nil { return LayerSemanticInvalid }
    return r.semantic
}

func (r *LayerTypeRef) Bare() bool {
    return r != nil && r.bare
}

func (r *LayerTypeRef) Percent() bool {
    return r != nil && r.percent
}

func (r *LayerTypeRef) Element() *LayerTypeRef {
    if r == nil { return nil }
    return r.element
}

// LayerType is a generated static codec descriptor. Runtime code invokes its
// direct function pointers; it never interprets a schema catalog or reflects
// over values. preflight remains an internal validation/testing contract;
// production encoding is a single transactional pass through encode.
type LayerType[T any] struct {
    ref    *LayerTypeRef
    preflight func(LayerProfile, T) (int, error)
    encode func(LayerProfile, T, *bin.Buffer) error
    decode func(LayerProfile, *bin.Buffer) (T, error)
    decodeState func(LayerProfile, *bin.Buffer, *layerCodecState) (T, error)
}

// Ref returns immutable complete TL type metadata.
func (t LayerType[T]) Ref() *LayerTypeRef { return t.ref }

// EncodeLayer is the only profile-aware encoding entry point. RPC results,
// active updates, and difference responses all call this function.
func EncodeLayer[T any](profile LayerProfile, typ LayerType[T], value T, b *bin.Buffer) error {
    if _, ok := ResolveLayerProfile(int(profile)); !ok {
        return &LayerCodecError{Operation: "encode", Profile: profile, Reason: "unsupported exact profile"}
    }
    if typ.ref == nil || typ.encode == nil {
        return &LayerCodecError{Operation: "encode", Profile: profile, Reason: "invalid layer type descriptor"}
    }
    if b == nil {
        return &LayerCodecError{Operation: "encode", Profile: profile, Type: typ.ref, Reason: "nil buffer"}
    }
    return layerCodecEncodeAtomic(profile, b, func() error {
        return typ.encode(profile, value, b)
    })
}

// LayerDecodeLimits bounds one generated decode/admission operation. Zero
// selects the generated default for that field. Negative values are rejected,
// and values above a generated hard limit are capped by the private decoder
// initializer before any typed decode begins.
type LayerDecodeLimits struct {
    MaxWireBytes int
    MaxVectorElements int
    MaxAggregateElements int
    MaxDepth int
}

func (l LayerDecodeLimits) layerCodecDecodeLimits() layerCodecDecodeLimits {
    return layerCodecDecodeLimits{
        maxWireBytes: l.MaxWireBytes,
        maxVectorElements: l.MaxVectorElements,
        maxAggregateElements: l.MaxAggregateElements,
        maxDepth: l.MaxDepth,
    }
}

// DecodeLayer is the default-bounded profile-aware decoding entry point.
func DecodeLayer[T any](profile LayerProfile, typ LayerType[T], b *bin.Buffer) (T, error) {
    return DecodeLayerWithLimits(profile, typ, b, LayerDecodeLimits{})
}

// DecodeLayerWithLimits decodes one complete generated TypeRef with a shared
// depth/vector/aggregate/wire-byte budget initialized before typed decoding.
// Nested constructors and sibling vectors consume that same request-scoped
// budget; no runtime schema walker or reflection is involved.
func DecodeLayerWithLimits[T any](profile LayerProfile, typ LayerType[T], b *bin.Buffer, limits LayerDecodeLimits) (T, error) {
    var zero T
    if _, ok := ResolveLayerProfile(int(profile)); !ok {
        return zero, &LayerCodecError{Operation: "decode", Profile: profile, Reason: "unsupported exact profile"}
    }
    if typ.ref == nil || typ.decodeState == nil {
        return zero, &LayerCodecError{Operation: "decode", Profile: profile, Reason: "invalid layer type descriptor"}
    }
    if b == nil {
        return zero, &LayerCodecError{Operation: "decode", Profile: profile, Type: typ.ref, Reason: "nil buffer"}
    }
    state, err := newLayerCodecDecodeState(profile, b.Len(), limits.layerCodecDecodeLimits())
    if err != nil { return zero, err }
    return typ.decodeState(profile, b, state)
}

// LayerCodecError is a typed hard failure. In particular, an unavailable or
// unresolved low-layer value never falls back to canonical bytes.
type LayerCodecError struct {
    Operation string
    Profile   LayerProfile
    Semantic  LayerSemanticID
    WireID    uint32
    Type      *LayerTypeRef
    Reason    string
    Cause     error
}

// ErrLayerUnknownRPCMethod classifies an exact-profile constructor that is not
// present in the generated RPC universe. Callers must use errors.Is instead of
// parsing LayerCodecError.Reason text.
var ErrLayerUnknownRPCMethod = errors.New("unknown generated layer RPC method")

// Unwrap preserves typed policy/adapter failures across the generated codec
// boundary. Callers may classify a failure without parsing Reason.
func (e *LayerCodecError) Unwrap() error {
    if e == nil { return nil }
    return e.Cause
}

// LayerProjectionError reports an explicit profile projection decision.
// Dropped values produce no bytes; callers encoding a single active update
// may use IsLayerProjectionDrop to skip delivery. Generated vector/difference
// codecs consume the same decision before writing their vector header.
type LayerProjectionError struct {
    Profile  LayerProfile
    Semantic LayerSemanticID
    Dropped  bool
    Reason   string
}

func (e *LayerProjectionError) Error() string {
    if e == nil { return "<nil>" }
    category, qname, _ := LayerSemanticName(e.Semantic)
    action := "projection failed"
    if e.Dropped { action = "projection dropped value" }
    if qname != "" {
        return fmt.Sprintf("layer %d %s for %s:%s: %s", e.Profile, action, category, qname, e.Reason)
    }
    return fmt.Sprintf("layer %d %s: %s", e.Profile, action, e.Reason)
}

// IsLayerProjectionDrop reports an intentional no-byte projection.
func IsLayerProjectionDrop(err error) bool {
    var projection *LayerProjectionError
    return errors.As(err, &projection) && projection.Dropped
}

func (e *LayerCodecError) Error() string {
    if e == nil { return "<nil>" }
    category, qname, _ := LayerSemanticName(e.Semantic)
    if qname != "" {
        return fmt.Sprintf("layer %d %s %s:%s (%#08x): %s", e.Profile, e.Operation, category, qname, e.WireID, e.Reason)
    }
    if e.Type != nil && e.Type.qname != "" {
        return fmt.Sprintf("layer %d %s %s: %s", e.Profile, e.Operation, e.Type.qname, e.Reason)
    }
    return fmt.Sprintf("layer %d %s: %s", e.Profile, e.Operation, e.Reason)
}

// LayerCall is the immutable RPC delivery context frozen while the request is
// admitted. Result encoding must use this value instead of mutable session
// layer state.
type LayerCall struct {
    profile         LayerProfile
    method          LayerSemanticID
    wireID          uint32
    canonicalResult *LayerTypeRef
    wireResult      *LayerTypeRef
    canonical       layerBoundType
    result          layerBoundType
    adaptResult     func(LayerProfile, any) (any, error)
}

// LayerCallIdentity is an opaque, comparable in-process identity for the
// exact result representation frozen at request admission. Request arguments
// are deliberately excluded; LayerPreparedCallIdentity adds their wire
// digest for flight/result-cache collision checks.
type LayerCallIdentity struct {
    profile         LayerProfile
    method          LayerSemanticID
    wireID          uint32
    canonicalResult *LayerTypeRef
    wireResult      *LayerTypeRef
}

func (c LayerCall) Profile() LayerProfile { return c.profile }
func (c LayerCall) Method() LayerSemanticID { return c.method }
func (c LayerCall) WireID() uint32 { return c.wireID }
func (c LayerCall) CanonicalResultType() *LayerTypeRef { return c.canonicalResult }
func (c LayerCall) WireResultType() *LayerTypeRef { return c.wireResult }
func (c LayerCall) Identity() LayerCallIdentity {
    return LayerCallIdentity{
        profile: c.profile,
        method: c.method,
        wireID: c.wireID,
        canonicalResult: c.canonicalResult,
        wireResult: c.wireResult,
    }
}

// EncodeResult encodes a canonical handler result using the exact result
// grammar frozen when the request was admitted. It shares the same bound
// static codec core as EncodeLayer; there is no separate push encoder.
func (c LayerCall) EncodeResult(value any, b *bin.Buffer) error {
    if _, ok := ResolveLayerProfile(int(c.profile)); !ok {
        return &LayerCodecError{Operation: "encode RPC result", Profile: c.profile, Semantic: c.method, WireID: c.wireID, Reason: "unsupported exact profile"}
    }
    if b == nil || c.canonicalResult == nil || c.wireResult == nil || c.result.ref == nil ||
        c.result.encode == nil {
        return &LayerCodecError{Operation: "encode RPC result", Profile: c.profile, Semantic: c.method, WireID: c.wireID, Reason: "invalid frozen result descriptor"}
    }
    wireValue := value
    if c.adaptResult != nil {
        adapted, err := c.adaptResult(c.profile, value)
        if err != nil {
            return &LayerCodecError{Operation: "adapt RPC result", Profile: c.profile, Semantic: c.method, WireID: c.wireID, Reason: err.Error(), Cause: err}
        }
        wireValue = adapted
    }
    state := layerCodecState{}
    return layerCodecEncodeAtomic(c.profile, b, func() error {
        return c.result.encode(c.profile, wireValue, b, &state)
    })
}

// LayerFrozen is an immutable canonical representation paired with its exact
// generated TypeRef. Fields stay private so profile-specific bytes cannot be
// mislabeled as canonical.
type LayerFrozen[T any] struct {
    typ  LayerType[T]
    body []byte
    valid bool
}

func (f LayerFrozen[T]) CanonicalSize() int { return len(f.body) }

// FreezeLayer makes a defensive canonical byte snapshot. The caller may
// mutate value after this function returns without changing future encodes.
func FreezeLayer[T any](typ LayerType[T], value T) (LayerFrozen[T], error) {
    if typ.ref == nil || typ.encode == nil || typ.decode == nil {
        return LayerFrozen[T]{}, &LayerCodecError{Operation: "freeze", Profile: LayerProfileCanonical, Reason: "invalid layer type descriptor"}
    }
    var encoded bin.Buffer
    if err := EncodeLayer(LayerProfileCanonical, typ, value, &encoded); err != nil {
        return LayerFrozen[T]{}, fmt.Errorf("freeze canonical layer value: %w", err)
    }
    return LayerFrozen[T]{typ: typ, body: append([]byte(nil), encoded.Raw()...), valid: true}, nil
}

// EncodeFrozenLayer is a convenience path: every call decodes the immutable
// canonical snapshot and runs the target-profile encoder again. Callers that
// fan one value out repeatedly must use PrepareFrozenLayer so conversion and
// encoding happen only once. There is no push-specific encoder.
func EncodeFrozenLayer[T any](profile LayerProfile, frozen LayerFrozen[T], b *bin.Buffer) error {
    if !frozen.valid || frozen.typ.ref == nil || frozen.typ.decode == nil {
        return &LayerCodecError{Operation: "encode frozen", Profile: profile, Reason: "invalid frozen layer value"}
    }
    canonical := bin.Buffer{Buf: frozen.body}
    value, err := DecodeLayer(LayerProfileCanonical, frozen.typ, &canonical)
    if err != nil {
        return fmt.Errorf("decode frozen canonical layer value: %w", err)
    }
    if canonical.Len() != 0 {
        return &LayerCodecError{Operation: "decode frozen", Profile: LayerProfileCanonical, Type: frozen.typ.ref, Reason: fmt.Sprintf("%d trailing canonical bytes", canonical.Len())}
    }
    return EncodeLayer(profile, frozen.typ, value, b)
}

// LayerPreparedValue is one defensive target-profile wire snapshot bound to
// an exact profile and complete generated TypeRef identity. It is the cache
// and fan-out boundary for active updates and difference values.
type LayerPreparedValue[T any] struct {
    profile LayerProfile
    ref *LayerTypeRef
    body []byte
    valid bool
}

func (p LayerPreparedValue[T]) Profile() LayerProfile { return p.profile }
func (p LayerPreparedValue[T]) TypeRef() *LayerTypeRef { return p.ref }
func (p LayerPreparedValue[T]) WireSize() int { return len(p.body) }

func (p LayerPreparedValue[T]) validate(profile LayerProfile, typ LayerType[T], operation string) error {
    if _, ok := ResolveLayerProfile(int(profile)); !ok {
        return &LayerCodecError{Operation: operation, Profile: profile, Type: typ.ref, Reason: "unsupported exact profile"}
    }
    if p.profile != profile {
        return &LayerCodecError{Operation: operation, Profile: profile, Type: typ.ref, Reason: fmt.Sprintf("prepared profile %d does not match requested profile", p.profile)}
    }
    if p.ref == nil || typ.ref == nil || p.ref != typ.ref {
        return &LayerCodecError{Operation: operation, Profile: profile, Type: typ.ref, Reason: "prepared TypeRef identity mismatch"}
    }
    if !p.valid {
        return &LayerCodecError{Operation: operation, Profile: profile, Type: typ.ref, Reason: "invalid prepared wire value"}
    }
    return nil
}

// PrepareFrozenLayer performs canonical decode, target conversion, and target
// encoding exactly once, then defensively owns the resulting wire bytes.
func PrepareFrozenLayer[T any](profile LayerProfile, frozen LayerFrozen[T]) (LayerPreparedValue[T], error) {
    if !frozen.valid || frozen.typ.ref == nil || frozen.typ.decode == nil {
        return LayerPreparedValue[T]{}, &LayerCodecError{Operation: "prepare frozen", Profile: profile, Reason: "invalid frozen layer value"}
    }
    var encoded bin.Buffer
    if err := EncodeFrozenLayer(profile, frozen, &encoded); err != nil {
        return LayerPreparedValue[T]{}, err
    }
    return LayerPreparedValue[T]{profile: profile, ref: frozen.typ.ref, body: encoded.Copy(), valid: true}, nil
}

// Encode appends the prepared bytes only when the caller supplies the exact
// profile and TypeRef identity used at preparation. Validation happens before
// the target buffer is changed.
func (p LayerPreparedValue[T]) Encode(profile LayerProfile, typ LayerType[T], b *bin.Buffer) error {
    if err := p.validate(profile, typ, "encode prepared"); err != nil { return err }
    if b == nil {
        return &LayerCodecError{Operation: "encode prepared", Profile: profile, Type: typ.ref, Reason: "nil buffer"}
    }
    b.Put(p.body)
    return nil
}

// Append is the slice form of Encode. On identity failure it returns dst
// unchanged.
func (p LayerPreparedValue[T]) Append(profile LayerProfile, typ LayerType[T], dst []byte) ([]byte, error) {
    if err := p.validate(profile, typ, "append prepared"); err != nil { return dst, err }
    return append(dst, p.body...), nil
}

// LayerFrozenResult is a defensive canonical RPC result snapshot. A result
// may be re-encoded by a different exact Call only when both calls have the
// same complete canonical result TypeRef; this is the safe rewrap boundary.
type LayerFrozenResult struct {
    canonicalRef *LayerTypeRef
    canonical    layerBoundType
    body         []byte
    valid        bool
}

func (f LayerFrozenResult) CanonicalSize() int { return len(f.body) }

// FreezeResult snapshots a canonical handler result before it enters flight,
// cache, retry, or rewrap state.
func (c LayerCall) FreezeResult(value any) (LayerFrozenResult, error) {
    if c.canonicalResult == nil || c.canonical.ref == nil ||
        c.canonical.encode == nil || c.canonical.decode == nil {
        return LayerFrozenResult{}, &LayerCodecError{Operation: "freeze RPC result", Profile: c.profile, Semantic: c.method, WireID: c.wireID, Reason: "invalid canonical result descriptor"}
    }
    state := layerCodecState{}
    var encoded bin.Buffer
    if err := layerCodecEncodeAtomic(LayerProfileCanonical, &encoded, func() error {
        return c.canonical.encode(LayerProfileCanonical, value, &encoded, &state)
    }); err != nil {
        return LayerFrozenResult{}, err
    }
    return LayerFrozenResult{
        canonicalRef: c.canonicalResult,
        canonical: c.canonical,
        body: append([]byte(nil), encoded.Raw()...),
        valid: true,
    }, nil
}

// EncodeFrozenResult re-encodes a canonical frozen result with this Call's
// exact profile and wire result TypeRef. This is used for cache replay and
// cross-profile initConnection rewrap; final wire bytes are never cloned
// across unequal call identities.
func (c LayerCall) EncodeFrozenResult(frozen LayerFrozenResult, b *bin.Buffer) error {
    if !frozen.valid || frozen.canonicalRef == nil || frozen.canonical.ref == nil {
        return &LayerCodecError{Operation: "encode frozen RPC result", Profile: c.profile, Semantic: c.method, WireID: c.wireID, Reason: "invalid frozen result"}
    }
    if frozen.canonicalRef != c.canonicalResult {
        return &LayerCodecError{Operation: "encode frozen RPC result", Profile: c.profile, Semantic: c.method, WireID: c.wireID, Reason: "canonical result TypeRef mismatch"}
    }
    state := layerCodecState{}
    canonical := bin.Buffer{Buf: frozen.body}
    value, err := frozen.canonical.decode(LayerProfileCanonical, &canonical, &state)
    if err != nil { return fmt.Errorf("decode frozen canonical RPC result: %w", err) }
    if canonical.Len() != 0 {
        return &LayerCodecError{Operation: "decode frozen RPC result", Profile: LayerProfileCanonical, Semantic: c.method, WireID: c.wireID, Reason: fmt.Sprintf("%d trailing canonical bytes", canonical.Len())}
    }
    return c.EncodeResult(value, b)
}

// LayerPreparedResult is one defensive RPC result wire snapshot bound to the
// complete admitted LayerCall identity. In particular, final bytes cannot be
// replayed under a different profile, method, wire ID, or result TypeRef.
type LayerPreparedResult struct {
    identity LayerCallIdentity
    body []byte
    valid bool
}

func (p LayerPreparedResult) Identity() LayerCallIdentity { return p.identity }
func (p LayerPreparedResult) WireSize() int { return len(p.body) }

func (p LayerPreparedResult) validate(call LayerCall, operation string) error {
    if !p.valid || call.canonicalResult == nil || call.wireResult == nil ||
        call.canonical.ref == nil || call.result.ref == nil {
        return &LayerCodecError{Operation: operation, Profile: call.profile, Semantic: call.method, WireID: call.wireID, Reason: "invalid prepared RPC result or call descriptor"}
    }
    if p.identity != call.Identity() {
        return &LayerCodecError{Operation: operation, Profile: call.profile, Semantic: call.method, WireID: call.wireID, Reason: "prepared RPC result call identity mismatch"}
    }
    return nil
}

func layerPrepareRPCResult(call LayerCall, encode func(*bin.Buffer) error) (LayerPreparedResult, error) {
    if encode == nil {
        return LayerPreparedResult{}, &LayerCodecError{Operation: "prepare RPC result", Profile: call.profile, Semantic: call.method, WireID: call.wireID, Reason: "nil result encoder"}
    }
    var encoded bin.Buffer
    if err := encode(&encoded); err != nil { return LayerPreparedResult{}, err }
    return LayerPreparedResult{identity: call.Identity(), body: encoded.Copy(), valid: true}, nil
}

// prepareResult encodes a live canonical handler result exactly once with the
// immutable call captured at admission.
func (c LayerCall) prepareResult(value any) (LayerPreparedResult, error) {
    return layerPrepareRPCResult(c, func(encoded *bin.Buffer) error {
        return c.EncodeResult(value, encoded)
    })
}

// PrepareFrozenResult converts and encodes one canonical frozen result once
// for this exact call. The returned bytes are reusable only with the same full
// LayerCall identity.
func (c LayerCall) PrepareFrozenResult(frozen LayerFrozenResult) (LayerPreparedResult, error) {
    return layerPrepareRPCResult(c, func(encoded *bin.Buffer) error {
        return c.EncodeFrozenResult(frozen, encoded)
    })
}

// Encode appends prepared result bytes only after validating the complete
// call identity. Validation failure leaves b unchanged.
func (p LayerPreparedResult) Encode(call LayerCall, b *bin.Buffer) error {
    if err := p.validate(call, "encode prepared RPC result"); err != nil { return err }
    if b == nil {
        return &LayerCodecError{Operation: "encode prepared RPC result", Profile: call.profile, Semantic: call.method, WireID: call.wireID, Reason: "nil buffer"}
    }
    b.Put(p.body)
    return nil
}

// Append is the slice form of Encode. On identity failure it returns dst
// unchanged.
func (p LayerPreparedResult) Append(call LayerCall, dst []byte) ([]byte, error) {
    if err := p.validate(call, "append prepared RPC result"); err != nil { return dst, err }
    return append(dst, p.body...), nil
}

// LayerPreparedCallIdentity is the comparable cache/flight identity for one
// exact admitted request. It combines the frozen result representation with
// the full outer wire request bytes, including transparent wrappers.
type LayerPreparedCallIdentity struct {
    call       LayerCallIdentity
    wireSize   int
    wireDigest [32]byte
}

// layerRPCRequestType is the generated canonical constructor identity for one
// innermost semantic method request. Values are package statics; pointer
// identity is therefore stable and collision-free within the generated API.
type layerRPCRequestType struct {
    method LayerSemanticID
    canonicalWireID uint32
}

// LayerSemanticRequestIdentity is the opaque, comparable identity of an
// already-converted innermost canonical RPC request. It deliberately excludes
// all outer wrappers. Equality proves only the same semantic method and
// canonical arguments; wrapper side effects (takeout, dependency ordering,
// update suppression, initConnection, and similar) must still be approved by
// the wrapper consumer or caller before any rewrap/cache reuse.
type LayerSemanticRequestIdentity struct {
    method LayerSemanticID
    requestType *layerRPCRequestType
    canonicalSize int
    canonicalDigest [32]byte
    valid bool
}

func (i LayerSemanticRequestIdentity) Method() LayerSemanticID { return i.method }
func (i LayerSemanticRequestIdentity) CanonicalSize() int { return i.canonicalSize }
func (i LayerSemanticRequestIdentity) CanonicalDigest() [32]byte { return i.canonicalDigest }

// LayerPreparedCall is immutable admission metadata carried from RPC decode
// through handler execution and result delivery.
type LayerPreparedCall struct {
    call       LayerCall
    wireSize   int
    wireDigest [32]byte
    semanticIdentity LayerSemanticRequestIdentity
}

func (p LayerPreparedCall) Call() LayerCall { return p.call }
func (p LayerPreparedCall) WireSize() int { return p.wireSize }
func (p LayerPreparedCall) WireDigest() [32]byte { return p.wireDigest }
func (p LayerPreparedCall) SemanticIdentity() LayerSemanticRequestIdentity { return p.semanticIdentity }
func (p LayerPreparedCall) Identity() LayerPreparedCallIdentity {
    return LayerPreparedCallIdentity{call: p.call.Identity(), wireSize: p.wireSize, wireDigest: p.wireDigest}
}

type layerRPCWrapperField struct {
    name string
    present bool
    direct bool
    value any
    profile LayerProfile
    typ layerBoundType
    state layerCodecState
    body []byte
    frozen bool
}

// LayerRPCWrapper is immutable metadata for one transparently unwrapped RPC
// envelope. Generated admission records every non-query field; callers can
// inspect it without receiving a mutable field slice.
type LayerRPCWrapper struct {
    profile LayerProfile
    semantic LayerSemanticID
    wireID uint32
    fields []layerRPCWrapperField
}

func (w LayerRPCWrapper) Profile() LayerProfile { return w.profile }
func (w LayerRPCWrapper) Semantic() LayerSemanticID { return w.semantic }
func (w LayerRPCWrapper) WireID() uint32 { return w.wireID }
func (w LayerRPCWrapper) Value(name string) (value any, present bool, ok bool, err error) {
    for index := range w.fields {
        field := w.fields[index]
        if field.name != name { continue }
        if !field.present { return nil, false, true, nil }
        if field.direct { return field.value, true, true, nil }
        if !field.frozen || field.typ.ref == nil || field.typ.decode == nil {
            return nil, true, true, &LayerCodecError{Operation: "decode RPC wrapper metadata", Profile: w.profile, Semantic: w.semantic, WireID: w.wireID, Reason: fmt.Sprintf("field %q has an invalid frozen TypeRef", name)}
        }
        state := field.state
        body := bin.Buffer{Buf: append([]byte(nil), field.body...)}
        decoded, decodeErr := field.typ.decode(field.profile, &body, &state)
        if decodeErr != nil {
            return nil, true, true, &LayerCodecError{Operation: "decode RPC wrapper metadata", Profile: w.profile, Semantic: w.semantic, WireID: w.wireID, Type: field.typ.ref, Reason: fmt.Sprintf("decode field %q: %v", name, decodeErr), Cause: decodeErr}
        }
        if body.Len() != 0 {
            return nil, true, true, &LayerCodecError{Operation: "decode RPC wrapper metadata", Profile: w.profile, Semantic: w.semantic, WireID: w.wireID, Type: field.typ.ref, Reason: fmt.Sprintf("field %q has %d trailing frozen bytes", name, body.Len())}
        }
        return decoded, true, true, nil
    }
    return nil, false, false, nil
}

// layerRPCRequestLease is shared by every value-copy of a LayerRequest.
// Server dispatch atomically consumes dispatched; callers cannot duplicate a
// request by copying its public admission token.
type layerRPCRequestLease struct {
    request bin.Object
    dispatched uint32
}

// LayerRequest is one canonical generated RPC request, its immutable
// prepared admission, and the outer-to-inner transparent wrapper chain.
// Private fields prevent callers from replacing a frozen Call or constructing
// a request which bypassed generated admission.
type LayerRequest struct {
    lease *layerRPCRequestLease
    prepared LayerPreparedCall
    wrappers []LayerRPCWrapper
}

func (r LayerRequest) Prepared() LayerPreparedCall { return r.prepared }
func (r LayerRequest) Call() LayerCall { return r.prepared.call }
func (r LayerRequest) WrapperCount() int { return len(r.wrappers) }
func (r LayerRequest) Wrapper(index int) (LayerRPCWrapper, bool) {
    if index < 0 || index >= len(r.wrappers) { return LayerRPCWrapper{}, false }
    return r.wrappers[index], true
}
